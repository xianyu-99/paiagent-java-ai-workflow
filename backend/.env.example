# 服务器配置
SERVER_PORT=8084

# 数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=paiagent
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MinIO 配置
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# JWT 配置（必须修改！建议使用 32 字符以上的随机字符串）
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_change_this_in_production

# API Key AES/GCM 加密密钥（必须长期稳定，修改后历史密钥无法解密）
API_KEY_ENCRYPTION_SECRET=your_api_key_encryption_secret_minimum_32_characters_change_this

# 默认管理员账户（生产环境建议禁用或修改）
# 留空则禁用默认账户，必须通过注册功能创建账户
APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123

# OpenAI 配置（可选，节点配置可覆盖）
OPENAI_API_KEY=sk-your-openai-api-key-here

# 工作流执行可靠性配置
# 默认不自动重试，避免 LLM/TTS 节点产生额外调用成本；需要时可在节点配置 retryCount 覆盖
WORKFLOW_NODE_TIMEOUT_MS=120000
WORKFLOW_NODE_RETRY_COUNT=0
WORKFLOW_MAX_NODE_RETRY_COUNT=3
WORKFLOW_NODE_RETRY_BACKOFF_MS=500
WORKFLOW_NODE_EXECUTOR_POOL_SIZE=8

# RAG Embedding 配置
# local: 本地 Hash Embedding，适合离线复现；dashscope: 阿里云百炼真实语义向量
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_TIMEOUT_MS=30000
RAG_EMBEDDING_BATCH_SIZE=16
