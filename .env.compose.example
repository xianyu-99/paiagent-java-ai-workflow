# Copy to .env if you want to override docker-compose defaults.

MYSQL_ROOT_PASSWORD=123456
REDIS_PASSWORD=123456

JWT_SECRET=change_me_jwt_secret_minimum_32_characters_for_demo
API_KEY_ENCRYPTION_SECRET=change_me_api_key_crypto_secret_minimum_32_characters

APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123

# For LAN demos, set this to your host IP, for example:
# MINIO_PUBLIC_URL=http://192.168.1.20:9000
MINIO_PUBLIC_URL=http://localhost:9000

# Workflow execution reliability.
WORKFLOW_NODE_TIMEOUT_MS=120000
WORKFLOW_NODE_RETRY_COUNT=0
WORKFLOW_MAX_NODE_RETRY_COUNT=3
WORKFLOW_NODE_RETRY_BACKOFF_MS=500
WORKFLOW_NODE_EXECUTOR_POOL_SIZE=8

FRONTEND_PORT=5173
BACKEND_PORT=8085
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
