# Copy to .env.external when PaiAgent should reuse existing infrastructure.
#
# Start app only:
# docker compose --env-file .env.external -f docker-compose.app.yml up -d --build
#
# On Docker Desktop, host.docker.internal points from containers back to the host.

FRONTEND_PORT=5174
BACKEND_PORT=8085

EXTERNAL_MYSQL_HOST=host.docker.internal
EXTERNAL_MYSQL_PORT=3306
EXTERNAL_MYSQL_DATABASE=paiagent
EXTERNAL_MYSQL_USERNAME=root
EXTERNAL_MYSQL_PASSWORD=123456

EXTERNAL_REDIS_HOST=host.docker.internal
EXTERNAL_REDIS_PORT=6379
EXTERNAL_REDIS_PASSWORD=123456

EXTERNAL_MINIO_ENDPOINT=http://host.docker.internal:9000
EXTERNAL_MINIO_PUBLIC_URL=http://localhost:9000
EXTERNAL_MINIO_ACCESS_KEY=minioadmin
EXTERNAL_MINIO_SECRET_KEY=minioadmin

RAG_VECTOR_STORE_PROVIDER=qdrant
EXTERNAL_QDRANT_URL=http://host.docker.internal:6333
EXTERNAL_QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=paiagent_chunks
QDRANT_TIMEOUT_MS=30000
RAG_VECTOR_STORE_FALLBACK_TO_MYSQL=true

JWT_SECRET=change_me_jwt_secret_minimum_32_characters_external
API_KEY_ENCRYPTION_SECRET=change_me_api_key_crypto_secret_minimum_32_characters

APP_AUTH_DEFAULT_USERNAME=admin
APP_AUTH_DEFAULT_PASSWORD=admin123

OPENAI_API_KEY=sk-placeholder

WORKFLOW_NODE_TIMEOUT_MS=120000
WORKFLOW_NODE_RETRY_COUNT=0
WORKFLOW_MAX_NODE_RETRY_COUNT=3
WORKFLOW_NODE_RETRY_BACKOFF_MS=500
WORKFLOW_NODE_EXECUTOR_POOL_SIZE=8
